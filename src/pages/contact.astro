---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact">
	<Header />
	<main id="main">
		<section class="mx-auto max-w-2xl px-6 pt-20 pb-16">
			<p class="text-sm font-semibold tracking-[0.2em] uppercase text-clay mb-5">Contact</p>
			<h1 class="font-serif text-4xl sm:text-5xl leading-tight text-ink mb-6">
				Let's talk about your book
			</h1>
			<p class="text-lg text-ink/70 leading-relaxed mb-10">
				Tell me a bit about what you're trying to write. There's no obligation — this is a
				conversation, not a quote request.
			</p>

			<!-- Netlify Forms (data-netlify="true") -->
			<form
				name="contact"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				class="space-y-5"
			>
				<input type="hidden" name="form-name" value="contact" />
				<p class="hidden">
					<label>
						Don't fill this out if you're human: <input name="bot-field" />
					</label>
				</p>

				<div>
					<label for="name" class="block text-sm font-medium text-ink/80 mb-1.5">Name</label>
					<input
						type="text"
						name="name"
						id="name"
						required
						class="w-full rounded-md border border-stone-dark/70 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-clay/60"
					/>
				</div>

				<div>
					<label for="email" class="block text-sm font-medium text-ink/80 mb-1.5">Email</label>
					<input
						type="email"
						name="email"
						id="email"
						required
						class="w-full rounded-md border border-stone-dark/70 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-clay/60"
					/>
				</div>

				<div>
					<label for="project" class="block text-sm font-medium text-ink/80 mb-1.5">
						What are you trying to write?
					</label>
					<textarea
						name="project"
						id="project"
						rows="6"
						required
						class="w-full rounded-md border border-stone-dark/70 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-clay/60"
					></textarea>
				</div>

				<button
					type="submit"
					class="inline-flex items-center rounded-md bg-clay px-6 py-3 text-sm font-semibold text-ivory hover:bg-clay-dark transition-colors"
				>
					Send
				</button>
			</form>

			<p class="mt-10 text-sm text-ink/60">
				Prefer email? Reach me directly at{' '}
				<a
					href="mailto:edierainforest@yahoo.com"
					class="text-clay hover:text-clay-dark font-medium"
				>
					edierainforest@yahoo.com
				</a>
				<!-- TODO: add a Calendly/booking link here if wanted -->
			</p>
		</section>
	</main>
	<Footer />
</Layout>
